---
// 暫用圖形標誌，之後可換成社團正式 Logo（放 public/ 後改成 <img>）
const { size = 38 } = Astro.props;
---
<svg width={size} height={size} viewBox="0 0 48 48" aria-hidden="true">
  <path d="M24 3c9 0 20 5 21 17s-7 24-20 25S3 38 3 25 15 3 24 3Z" fill="#2f6bff"/>
  <circle cx="24" cy="24" r="5" fill="#c6f432"/>
  <ellipse cx="24" cy="24" rx="15" ry="6" fill="none" stroke="#fff" stroke-width="2.2" transform="rotate(30 24 24)"/>
  <ellipse cx="24" cy="24" rx="15" ry="6" fill="none" stroke="#fff" stroke-width="2.2" transform="rotate(-30 24 24)"/>
</svg>
