---
import { mapPoints } from '../data/site';
---
<div class="map reveal" role="group" aria-label="高雄合作學校示意地圖">
  <svg class="land" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
    <path d="M18 4 C35 2 60 6 78 14 C92 22 96 40 90 58 C86 74 78 92 60 97 C42 100 30 94 22 82 C14 70 12 56 14 40 C15 26 10 10 18 4 Z" />
    <path class="coast" d="M6 10 C14 30 16 55 26 75 C32 88 38 96 44 100" />
  </svg>
  <span class="sea en" aria-hidden="true">TAIWAN STRAIT</span>
  {mapPoints.map((p, i) => (
    <div class:list={['pin', { home: p.home }]} style={`left:${p.x}%;top:${p.y}%;--i:${i}`}>
      <span class="dot" aria-hidden="true"></span>
      <span class="label"><strong>{p.name}</strong><small>{p.note}</small></span>
    </div>
  ))}
  <p class="note">＊示意圖，非實際比例</p>
</div>
<style>
  .map {
    position: relative; aspect-ratio: 4 / 5; max-width: 520px; width: 100%; margin-inline: auto;
    background: radial-gradient(circle at 20% 20%, #17306e, var(--navy-2)); border-radius: var(--radius); overflow: hidden;
    background-image: radial-gradient(rgba(124,200,255,.18) 1px, transparent 1px); background-size: 18px 18px; background-color: var(--navy-2);
  }
  .land { position: absolute; inset: 8% 6% 6% 18%; width: 76%; height: 86%; }
  .land path { fill: rgba(47,107,255,.35); stroke: rgba(124,200,255,.5); stroke-width: .4; }
  .land .coast { fill: none; stroke-dasharray: 1.5 1.5; }
  .sea { position: absolute; left: 4%; bottom: 8%; font-size: .65rem; letter-spacing: .3em; color: rgba(124,200,255,.4); writing-mode: vertical-rl; }
  .pin { position: absolute; transform: translate(-7px, -7px); display: flex; align-items: center; gap: 8px; }
  .dot { width: 14px; height: 14px; border-radius: 50%; background: var(--sky); position: relative; flex: none; }
  .dot::after { content: ''; position: absolute; inset: -6px; border-radius: 50%; border: 2px solid var(--sky); opacity: 0; }
  .map:global(.is-in) .dot::after { animation: ping 2.4s var(--ease) infinite; animation-delay: calc(var(--i) * .3s); }
  .home .dot { background: var(--lime); width: 18px; height: 18px; }
  .home .dot::after { border-color: var(--lime); }
  .label { display: flex; flex-direction: column; line-height: 1.2; background: rgba(10,22,51,.8); padding: .35em .7em; border-radius: 8px; white-space: nowrap; }
  .label strong { font-size: .82rem; color: var(--white); }
  .label small { font-size: .68rem; color: var(--sky); }
  .note { position: absolute; right: 12px; bottom: 6px; font-size: .68rem; color: rgba(255,255,255,.4); margin: 0; }
  @keyframes ping { 0% { transform: scale(.6); opacity: .9; } 100% { transform: scale(2); opacity: 0; } }
</style>
