---
import { nav } from '../data/nav';
import { url } from '../scripts/utils';
import Logo from './Logo.astro';
const path = Astro.url.pathname;
const isActive = (href: string) => path.startsWith(url(href));
---
<header class="site-header">
  <div class="wrap bar">
    <a class="brand" href={url()} aria-label="回到首頁">
      <Logo />
      <span class="brand-text">
        <strong>高大科傳社</strong>
        <small class="en">NUK SCICOMM</small>
      </span>
    </a>
    <nav class="desktop-nav" aria-label="主選單">
      {nav.filter((n) => n.href !== 'join').map((n) => (
        <a href={url(n.href)} aria-current={isActive(n.href) ? 'page' : undefined}>{n.label}</a>
      ))}
    </nav>
    <div class="actions">
      <a class="btn btn--lime join-cta" href={url('join')}>
        <span class="en">JOIN US</span>
      </a>
      <button class="nav-toggle" aria-expanded="false" aria-controls="mobile-nav" aria-label="開啟選單">
        <span></span><span></span>
      </button>
    </div>
  </div>
  <nav id="mobile-nav" class="mobile-nav" aria-label="手機選單">
    <div class="wrap">
      <a href={url()}><span class="en">HOME</span>首頁</a>
      {nav.map((n) => (
        <a href={url(n.href)}><span class="en">{n.en}</span>{n.label}</a>
      ))}
    </div>
  </nav>
</header>

<style>
  .site-header {
    position: fixed; inset: 0 0 auto 0; z-index: 50; color: var(--white);
    padding-top: env(safe-area-inset-top, 0px);
    transition: background .3s, box-shadow .3s, backdrop-filter .3s;
  }
  .site-header:global(.is-scrolled), :global(body.menu-open) .site-header {
    background: rgba(10, 22, 51, .88);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    box-shadow: 0 1px 0 rgba(255,255,255,.08);
  }
  .bar { display: flex; align-items: center; justify-content: space-between; gap: 16px; height: 72px; }
  .brand { display: flex; align-items: center; gap: 10px; text-decoration: none; }
  .brand-text { display: flex; flex-direction: column; line-height: 1.1; }
  .brand-text strong { font-size: 1rem; letter-spacing: .06em; }
  .brand-text small { font-size: .62rem; color: var(--sky); letter-spacing: .2em; }
  .desktop-nav { display: none; gap: 4px; }
  .desktop-nav a {
    text-decoration: none; padding: .5em .9em; border-radius: 999px; font-size: .95rem; font-weight: 500;
    transition: background .2s;
  }
  .desktop-nav a:hover, .desktop-nav a[aria-current] { background: rgba(255,255,255,.1); }
  .actions { display: flex; align-items: center; gap: 10px; }
  .join-cta { padding: .55em 1.1em; font-size: .85rem; }
  .nav-toggle {
    width: 44px; height: 44px; border-radius: 50%; border: 1px solid rgba(255,255,255,.3);
    background: transparent; display: grid; place-content: center; gap: 6px; cursor: pointer;
  }
  .nav-toggle span { display: block; width: 18px; height: 2px; background: var(--white); transition: transform .3s var(--ease); }
  .nav-toggle[aria-expanded="true"] span:first-child { transform: translateY(4px) rotate(45deg); }
  .nav-toggle[aria-expanded="true"] span:last-child { transform: translateY(-4px) rotate(-45deg); }
  .mobile-nav {
    display: grid; grid-template-rows: 0fr; transition: grid-template-rows .4s var(--ease);
  }
  .mobile-nav > .wrap { overflow: hidden; }
  :global(body.menu-open) .mobile-nav { grid-template-rows: 1fr; }
  .mobile-nav a {
    display: flex; justify-content: space-between; align-items: baseline; text-decoration: none;
    padding: 1em 0; border-bottom: 1px solid rgba(255,255,255,.1); font-size: 1.15rem; font-weight: 700;
  }
  .mobile-nav a:last-child { border: 0; margin-bottom: 1rem; }
  .mobile-nav .en { order: 2; font-size: .75rem; color: var(--sky); letter-spacing: .2em; }
  @media (min-width: 960px) {
    .desktop-nav { display: flex; }
    .nav-toggle, .mobile-nav { display: none; }
  }
  @media (max-width: 380px) { .brand-text small { display: none; } }
</style>
