---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { site } from '../data/site';
import { getProjects } from '../scripts/utils';

const cases = (await getProjects()).filter((p) => p.data.category !== 'member').slice(0, 6);
const services = [
  { t: '科學社團', en: 'SCIENCE CLUB', d: '定期至學校進行科學與科技實作課程。', i: '🏫' },
  { t: '科學營隊', en: 'SCIENCE CAMP', d: '短期、寒暑假營隊活動設計與帶領。', i: '⛺' },
  { t: 'STEM 工作坊', en: 'STEM WORKSHOP', d: '自走車、Arduino 等科技實作課程。', i: '🛠️' },
  { t: '科普攤位', en: 'SCIENCE BOOTH', d: '適合科學市集、園遊會與大型活動的互動攤位。', i: '🧪' },
  { t: '活動協作', en: 'EVENT SUPPORT', d: '大型競賽、科學活動的現場支援與工作人員。', i: '🤝' },
];
---
<Layout title="合作邀請" description="邀請高雄大學科學傳播社到你的學校或活動：科學社團、科學營隊、STEM 工作坊、科普攤位與大型活動協作。">
  <PageHero eyebrow="Collaborate" title="想一起把科學<br />帶到更多地方？" lead="給國中、高中、老師、學校、基金會、政府、企業與教育單位。">
    <a class="btn btn--lime" href="#contact">聯絡我們 <span class="arrow" aria-hidden="true">↓</span></a>
  </PageHero>

  <section class="section section--white">
    <div class="wrap">
      <p class="eyebrow en">What we can do together</p>
      <h2 class="h-section">我們可以一起做</h2>
      <div class="services">
        {services.map((s, i) => (
          <div class="svc reveal" data-delay={i % 4}>
            <span class="ic" aria-hidden="true">{s.i}</span>
            <p class="en">{s.en}</p>
            <h3>{s.t}</h3>
            <p class="d">{s.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--ice">
    <div class="wrap">
      <p class="eyebrow en">Past collaborations</p>
      <h2 class="h-section">過往合作經驗</h2>
      <div class="grid grid-3" style="margin-top:32px">
        {cases.map((p, i) => <ProjectCard project={p} delay={i % 3} />)}
      </div>
    </div>
  </section>

  <section id="contact" class="section section--dark">
    <div class="wrap contact">
      <div>
        <p class="eyebrow en">Contact</p>
        <h2 class="h-section">聊聊你的想法</h2>
        <p class="lead">歡迎直接來信或透過 Instagram 聯絡我們。</p>
        <ul class="direct">
          <li><span>Email</span><a href={`mailto:${site.email}`}>{site.email}</a></li>
          <li><span>Instagram</span><a href={site.instagram} target="_blank" rel="noopener">{site.instagramHandle}</a></li>
        </ul>
      </div>
    </div>
  </section>
</Layout>

<style>
  .services { display: grid; gap: 16px; margin-top: 40px; grid-template-columns: repeat(auto-fit, minmax(min(100%, 210px), 1fr)); }
  .svc { border: 1px solid var(--line); border-radius: var(--radius); padding: 26px; transition: transform .35s var(--ease), box-shadow .35s, opacity .8s var(--ease); }
  .svc.is-in:hover { transform: translateY(-4px); box-shadow: var(--shadow); }
  .ic { font-size: 1.8rem; }
  .svc .en { font-size: .72rem; font-weight: 700; letter-spacing: .16em; color: var(--blue); margin: .8em 0 .2em; }
  .svc h3 { font-size: 1.25rem; }
  .d { color: var(--muted); font-size: .93rem; margin: 0; }
  .contact { display: grid; gap: 48px; max-width: 900px; margin-inline: auto; text-align: center; }
  .direct { list-style: none; padding: 0; margin: 32px 0 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr)); gap: 16px; }
  .direct li { display: flex; flex-direction: column; align-items: center; gap: 6px; padding: 22px; border: 1px solid rgba(255,255,255,.12); border-radius: var(--radius); background: rgba(255,255,255,.05); }
  .direct span { font-size: .78rem; color: var(--sky); letter-spacing: .1em; }
  .direct a { font-size: 1.15rem; font-weight: 700; text-decoration: none; word-break: break-all; }
</style>
